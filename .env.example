# Copy this file to .env and fill it in. Never commit .env.

# TikTok LIVE through Streamchime (free Hobby key: https://streamchime.com/app/developers).
# Without a key the game runs the simulator instead.
STREAMCHIME_APP_KEY=
TIKTOK_USERNAME=

# Gift that reveals one letter (default Rose). The control page can change it too.
HINT_GIFT=Rose

# Word data. Defaults shown. data/ is git-ignored and must never be committed.
# KBBI_CSV=./data/kbbi.csv
# SECRET_WORDS=./data/secret_words.txt
# Optional packs for the Easy and Hard difficulty. Without them, Easy uses words of 5 letters or
# fewer and Hard uses words of 8 letters or more from the main list.
# SECRET_WORDS_EASY=./data/secret_words_easy.txt
# SECRET_WORDS_HARD=./data/secret_words_hard.txt

# Optional: word2vec text file (for example cc.id.300.vec) to turn on meaning mode.
# VECTORS_PATH=./data/cc.id.300.vec
# Only the first N lines are read (the file is sorted by frequency).
# VECTORS_MAX_LINES=200000

# Web server. HOST=127.0.0.1 keeps the control page on this computer only.
PORT=3000
HOST=127.0.0.1

# Password for the control page. Required (and generated if empty) when HOST is not localhost.
# CONTROL_KEY=

# Start a round as soon as the server starts (otherwise press "Mulai ronde").
# AUTO_START=1

# Print every raw Streamchime event, for checking field names.
# DEBUG_LIVE=1

# Rotating event log in data/logs (2 MB x 5 files). It contains viewer names. 0 turns it off.
# EVENT_LOG=0
