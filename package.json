{
  "name": "contextoindo",
  "version": "1.0.0",
  "description": "Contexto Indo: an Indonesian meaning-ranking word game for TikTok LIVE. Guesses are ranked by closeness to the secret word.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "sim": "node src/server.js --sim",
    "test-mode": "node src/server.js --sim",
    "demo": "node src/server.js --demo",
    "test": "node --test \"test/*.test.js\"",
    "build-secrets": "python scripts/build_secret_words.py",
    "bench": "node scripts/bench.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "optionalDependencies": {
    "@streamchime/tiktok-live-sdk": "*"
  }
}
